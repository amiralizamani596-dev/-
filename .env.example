# Frontend data/auth mode
# mock = current frontend-only baseline behavior (recommended until backend is ready)
# api  = use real backend services (requires backend implementation/integration)
VITE_DATA_MODE=mock

# Backend API base URL (used when VITE_DATA_MODE=api)
# Leave empty to use same-origin /api paths (recommended for Vite dev proxy)
# Example for direct backend access: http://localhost:3001
VITE_API_BASE_URL=
